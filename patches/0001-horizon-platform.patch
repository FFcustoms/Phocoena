+u64 PresentCompletionTracker::Queue()
+{
+  std::lock_guard lock(m_mutex);
+  const u64 serial = ++m_state.queued;
+  m_state.peak_pending = std::max(m_state.peak_pending, m_state.queued - m_state.completed);
+  return serial;
+}
+
+void PresentCompletionTracker::Begin(u64 serial)
+{
+  std::lock_guard lock(m_mutex);
+  ASSERT_MSG(VIDEO, serial != 0 && serial == m_state.begun + 1 && m_state.active == 0,
+             "Invalid presentation begin transition");
+  m_state.begun = serial;
+  m_state.active = serial;
+}
+
+void PresentCompletionTracker::Complete(u64 serial)
+{
+  {
+    std::lock_guard lock(m_mutex);
+    ASSERT_MSG(VIDEO, serial != 0 && serial == m_state.completed + 1 &&
+                          m_state.active == serial && serial <= m_state.begun,
+               "Invalid presentation completion transition");
+    m_state.completed = serial;
+    m_state.active = 0;
+  }
+  m_completion.notify_all();
+}
+
+void PresentCompletionTracker::WaitFor(u64 serial)
+{
+  std::unique_lock lock(m_mutex);
+  m_completion.wait(lock, [this, serial] { return m_state.completed >= serial; });
+}
+
+void PresentCompletionTracker::WaitForLastQueued()
+{
+  std::unique_lock lock(m_mutex);
+  const u64 serial = m_state.queued;
+  m_completion.wait(lock, [this, serial] { return m_state.completed >= serial; });
+}
+
+PresentCompletionTracker::Snapshot PresentCompletionTracker::Read() const
+{
+  std::lock_guard lock(m_mutex);
+  return m_state;
+}
